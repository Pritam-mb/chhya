# ===================================================================
# Chhaya (ছায়া) Environment Configuration
# ===================================================================

# 1. Open Model Inference (Groq)
# Claim free credits at hacktoberfest.com/my/promos or console.groq.com
# Copy this file to .env (git-ignored) and put REAL keys there, never here.
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the open-weight model (default openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-120b

# 2. Voice Briefing (ElevenLabs)
# Claim free credits at hacktoberfest.com/my/promos or elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# 3. Optional Sentry Tracing (HTTP routes + agent tool spans)
SENTRY_DSN=
SENTRY_ENVIRONMENT=chhaya
SENTRY_TRACES_SAMPLE_RATE=1.0

# 4. Server Settings
PORT=8000
HOST=0.0.0.0
